# Copy to .env.local and update before production use.
# Never use NEXT_PUBLIC_* for these values.
# Quote/escape ADMIN_PASSWORD_HASH in .env.local — bcrypt hashes contain $
# which Next.js dotenv expansion would otherwise corrupt.
# Example local form: ADMIN_PASSWORD_HASH=\$2b\$12\$...
# On Vercel, paste the raw hash without backslashes.

# Temporary client starter bootstrap (username lovezthick is hardcoded in app code).
# Keep until the client finishes Neon email migration. Do not use NEXT_PUBLIC_*.
ADMIN_USERNAME=lovezthick
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=

# Neon (CreatorSiteHub shared project) — from `neon env pull` / Vercel Neon integration.
# Do not use NEXT_PUBLIC_* for database URLs or cookie secrets.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# NEON_BRANCH=
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=
# Generate locally: openssl rand -base64 32  (also set the same value on Vercel)
# NEON_AUTH_COOKIE_SECRET=

# Resend (auth + notification emails). Use verified domain — never onboarding@resend.dev.
# Do not use NEXT_PUBLIC_*. Never commit real keys.
# RESEND_API_KEY=
# EMAIL_FROM=enquiries@contactdesk.online
# EMAIL_FROM_NAME=Love Z Thick
# AUTH_EMAIL_FROM=Love Z Thick <enquiries@contactdesk.online>
# CONTACT_FROM_EMAIL=Website Enquiries <enquiries@contactdesk.online>

# Optional absolute app URL for invite/reset redirects (defaults to Vercel URL).
# APP_URL=https://thickzlove.vercel.app

# Vercel Blob (auto-set when a Blob store is linked to the project).
# Required on Vercel production for durable booking storage.
# Do not use NEXT_PUBLIC_* for these.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Admin gallery upload allowance (cumulative, per this website).
# Defaults to 100 if unset. Do not use NEXT_PUBLIC_*.
# GALLERY_STORAGE_LIMIT_MB=100

# Optional webhooks (unchanged)
# CONTACT_WEBHOOK_URL=
# BOOKING_WEBHOOK_URL=

# Booking/contact email recipients — set when you have the customer's addresses.
# Leave unset until then. Forms keep working without them; no email is sent yet.
# Do not use the developer attribution email for these.
# BOOKING_NOTIFICATION_EMAIL=
# CONTACT_NOTIFICATION_EMAIL=

# Contact-form owner notification (Resend)
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=Website Enquiries <enquiries@contactdesk.online>
# CONTACT_NOTIFICATION_EMAIL=  # alias for CONTACT_TO_EMAIL
